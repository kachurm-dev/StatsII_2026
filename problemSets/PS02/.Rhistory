additive_model <- glm(choice ~ countries + sanctions,
data = climateSupport,
family = binomial(link = "logit"))
null_deviance <- additive_model$null.deviance
residual_deviance <- additive_model$deviance
df_diff <- additive_model$df.null - additive_model$df.residual
test_stat <- null_deviance - residual_deviance
p_value <- pchisq(test_stat, df_diff, lower.tail = FALSE)
