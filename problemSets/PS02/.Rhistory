interaction_model
interaction_model <- glm(choice ~ countries * sanctions,
data = climateSupport,
family = binomial(link = "logit"))
interaction_model
interaction_model
# Extract deviances
dev_add <- additive_model$deviance
dev_int <- interaction_model$deviance
# Extract degrees of freedom
df_add <- additive_model$df.residual
df_int <- interaction_model$df.residual
# Compute test statistic
G2 <- dev_add - dev_int
df_diff <- df_add - df_int
# Compute p-value
p_value_interaction <- pchisq(G2, df_diff, lower.tail = FALSE)
G2
df_diff
p_value_interaction
anova(additive_model, interaction_model, test = "Chisq")
